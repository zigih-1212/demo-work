# OrthoDent Backend Environment Variables
# Copy this file to .env and fill in your values.
# Every setting uses the ORTHODENT_ prefix (pydantic-settings env_prefix).

# --- Database ---
# PostgreSQL (production):
# ORTHODENT_DATABASE_URL=postgresql+psycopg://user:password@host:5432/orthodent
# SQLite (single container / demo, no external database):
ORTHODENT_DATABASE_URL=sqlite+aiosqlite:///./orthodent.db

# --- Queue (optional) ---
# Scan processing runs synchronously when Redis is absent, so this is optional.
# ORTHODENT_REDIS_URL=redis://localhost:6379/0

# --- Security ---
ORTHODENT_SECRET_KEY=change-me-generate-with-python-secrets-token_urlsafe-32
ORTHODENT_ALGORITHM=HS256
ORTHODENT_ACCESS_TOKEN_TTL_MINUTES=720

# --- CORS ---
ORTHODENT_CORS_ORIGINS=["http://localhost:5173","https://demo-work.dvybornyh332.workers.dev"]

# --- Uploads ---
ORTHODENT_UPLOAD_DIR=./uploads
ORTHODENT_MAX_SCAN_BYTES=52428800
